{
  "manifest_version": 3,
  "name": "HKTR 序號助手",
  "description": "協助香港《跑Online》玩家加密儲存帳號，並在官方頁面填寫序號兌換資料。",
  "version": "2.3.0",
  "minimum_chrome_version": "102",
  "homepage_url": "https://hktr.uk/trredeem",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "externally_connectable": {
    "matches": [
      "https://hktr.uk/*",
      "https://www.hktr.uk/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HKTR 序號助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://trevent.funtown.com.hk/serial/app/serial_code.php"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://trevent.funtown.com.hk/serial/app/serial_code_handler.php"],
      "js": ["result.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/popup-logo.png"],
      "matches": ["https://trevent.funtown.com.hk/*"]
    }
  ]
}
